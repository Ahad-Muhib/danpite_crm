# ==============================================================================
# DANPITE CRM - Environment Configuration Example
# Copy this file to .env and configure the variables for your environment.
# ==============================================================================

# Security
# Generate a new secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-this-to-a-secure-random-secret-key-in-production

# Set to False in production!
DEBUG=False

# Allowed host header values (comma-separated, without spaces)
# Example: crm.yourcompany.com,127.0.0.1,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins for HTTPS (comma-separated with https://)
# Required in Django 4+ and 5+ for form submissions over HTTPS
# Example: https://crm.yourcompany.com,https://new-crm.danpitetech.com
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1

# Database Configuration
# Leave blank or commented out to use the default local SQLite database (db.sqlite3).
# For PostgreSQL in production:
# DATABASE_URL=postgres://crm_user:strong_password@localhost:5432/danpite_crm_db
# For MySQL:
# DATABASE_URL=

# SSL & Security Headers (Recommended True for HTTPS production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Email Configuration (SMTP)
# For local dev without sending real emails:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production with real SMTP server:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=Danpite CRM <no-reply@yourcompany.com>
